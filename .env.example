# Every setting h3ir has, with the reason for each default.
# Nothing auto-loads this file. h3ir reads plain environment variables, so:
#
#     cp .env.example .env          # then edit
#     set -a && . ./.env && set +a  # bash/zsh: export everything in it
#     h3ir doctor                   # prints what each value resolved to, and what answers
#
# H3IR_LLM_URL always needs changing, and H3IR_LLM_MODEL does too as soon as the endpoint holds
# more than one model. Every value below is a placeholder; nothing in this repo points at a real
# host.

# ---------------------------------------------------------------- the reasoning model (required)
# Any OpenAI-compatible endpoint: vLLM, llama.cpp's server, LM Studio, Ollama, a hosted API. They
# agree on /v1/chat/completions and on very little else, so h3ir asks each one what it is rather
# than assuming: two liveness paths are tried and `h3ir doctor` names the one that answered.
# It needs a vision tower, because reference images are read through it.
H3IR_LLM_URL=http://127.0.0.1:8000/v1

# Which model, when the endpoint holds more than one. On a server with a single model on it this
# can stay empty and that model is used, because there is nothing to choose. On one that routes
# several, Ollama being the usual case, h3ir refuses to pick and prints the ids it found: the model
# it needs is the one that can see, and no model list on any server reports vision. `h3ir doctor`
# reads a test picture through whatever you set here and reports `vision_ok`.
H3IR_LLM_MODEL=

# Sent as `Authorization: Bearer <key>` on every request, unless it is left at the placeholder
# below, in which case no header goes out at all. Local servers do not usually want a credential,
# and a made-up one is refused differently from a missing one, which would send you debugging the
# wrong thing. Set it for a hosted endpoint, or for a vLLM started with --api-key.
H3IR_LLM_KEY=not-needed

# Reasoning is the bulk of the spend, and a starved budget returns an empty answer with no
# error rather than a short one. 16000 is the floor that has been reliable.
H3IR_LLM_MAX_TOKENS=16000
H3IR_LLM_TIMEOUT=600

# ---------------------------------------------------------------- ComfyUI (optional)
# Only used to report which H3 nodes are installed and how much VRAM is free. Nothing here
# ever submits a render, and every command works with ComfyUI switched off.
H3IR_COMFY_URL=http://127.0.0.1:8188

# ---------------------------------------------------------------- style LoRAs (optional)
# os.pathsep-separated list of directories, each containing LoRA folders with a howtouse.md.
# Point it at this repo's ./loras to see the worked example.
H3IR_LORA_DIRS=

# ---------------------------------------------------------------- state (optional)
# Compiled-asset cache, recorded eval runs, and uploaded attachments. Safe to delete; it is all
# rebuildable.
H3IR_STATE_DIR=

# ---------------------------------------------------------------- attachments (optional)
# Two ways for a caller's media to reach the service, and both defaults are the ones that keep an
# existing install working unchanged.
#
# A `path` in the request is the fast way and it needs one filesystem: nothing is copied, and the
# bytes H3 is conditioned on are the bytes the caller already had. An upload is the way in for a
# caller on another machine, which cannot name a file this service can open under any spelling.

# Whether `path` is accepted at all. ON, because it is what every existing caller uses and the fast
# path on one machine. Turn it OFF on a service reachable by people you would not hand a shell to: a
# path is read with the service's own permissions and the file's contents come back described in the
# brief, so on an open network it is a way to read files. With it off, the only bytes this service
# reads are bytes a caller sent it.
H3IR_ALLOW_ASSET_PATHS=1

# The largest single upload, in bytes. 512 MiB covers anything a camera or a renderer produces at
# the lengths H3 reads -- a 15-second 4K clip at 50 Mbps is about 94 MB -- and it is small enough
# that one request cannot take a disk. 0 turns uploads off entirely.
H3IR_UPLOAD_MAX_BYTES=536870912

# The whole upload store, in bytes. A per-file limit alone bounds nothing over a week, because it is
# the total that fills a disk one legal upload at a time. Reaching this evicts the least recently
# used attachments; if that cannot free enough, the upload is refused rather than the cap being
# quietly exceeded.
H3IR_UPLOAD_STORE_BYTES=8589934592

# How long an uploaded attachment is kept. They are a cache and not a record -- every one of them
# can be sent again -- so they expire. 0 means keep them until the size cap needs the room.
H3IR_UPLOAD_TTL_HOURS=48

# ---------------------------------------------------------------- switches you probably want off
# Reasoning on the planning call. Measured on six briefs: 3.7x the wall time (292s vs 78s)
# and no quality metric moved. Off by default because of that measurement, not on principle.
H3IR_LLM_THINKING=0

# Server-side grammar enforcement. Off deliberately: with a reasoning parser active vLLM can
# skip the grammar silently (vLLM #39130), and llama.cpp #20345 reports the converse on this
# model family. Everything is validated in Python either way. See docs/design.md §5.
H3IR_GUIDED_DECODING=0

# Which wire shape a per-brief `num_ctx` override uses (see the `num_ctx` field on the /v1/briefs
# `llm` object). "auto" (default) detects Ollama once per request by asking {H3IR_LLM_URL's
# root}/api/version. "ollama" forces Ollama's native /api/chat, the only shape that actually
# raises the loaded context: Ollama's OpenAI-compatible /v1/chat/completions silently drops
# `options`/`num_ctx` (no field for it in its request struct), so num_ctx has no effect there.
# "openai" always uses /v1/chat/completions, for a non-Ollama endpoint. Leave at "auto" unless
# the /api/version probe itself is a problem (a proxy in front of Ollama that does not forward
# it, say).
H3IR_LLM_API=auto
